# Shopify App Credentials (from Shopify Partners Dashboard)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# App URL (your production domain, e.g., https://achty-shopify.vercel.app)
SHOPIFY_APP_URL=https://your-app-url.vercel.app

# Scopes (comma-separated, must match shopify.app.toml)
SCOPES=read_products,read_content,read_themes

# PostgreSQL Database URL (Supabase connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Billing test mode: set to "true" for development, remove or set "false" for production
BILLING_TEST_MODE=false

# Optional: Custom shop domain
# SHOP_CUSTOM_DOMAIN=

# Port (default: 3000)
PORT=3000
